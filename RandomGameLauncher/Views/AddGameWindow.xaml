<Window x:Class="RandomGameLauncher.Views.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:RandomGameLauncher.Resources.Language"
        mc:Ignorable="d"
        Background="{DynamicResource SteamBackground}"
        Foreground="{DynamicResource SteamForeground}"
        ResizeMode="NoResize"
        Title="{x:Static l:Strings.ADD_GAME}"
        Height="200"
        Width="600">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static l:Strings.PATH_EXE}" />

        <TextBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="0,0,0,8"
                 Text="{Binding SelectedFilePath, UpdateSourceTrigger=PropertyChanged}" />

        <Button Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,8"
                Content="{x:Static l:Strings.SEARCH}"
                Command="{Binding OpenDialogCommand}"
                Style="{DynamicResource PlayGameButton}" />

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text="{x:Static l:Strings.LAUNCH_ARGS}" />

        <TextBox Grid.Row="3"
                 Grid.ColumnSpan="2"
                 Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{x:Static l:Strings.CANCEL}" Click="Cancel_Click" Margin="60,0,30,0"
                    Style="{DynamicResource RemoveButton}" />

            <Button Content="{x:Static l:Strings.ADD}" Click="Add_Click" Margin="30,0,60,0"
                    Style="{DynamicResource PlayGameButton}" />
        </StackPanel>
    </Grid>
</Window>
