<Window x:Class="RandomGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RandomGameLauncher"
        xmlns:properties="clr-namespace:RandomGameLauncher.Properties"
        xmlns:l="clr-namespace:RandomGameLauncher.Resources.Language"
        mc:Ignorable="d"
        Background="{DynamicResource SteamWindowBackground}"
        Foreground="{DynamicResource SteamForeground}"
        FontFamily="Segoe UI"
        Title="Random Game Launcher" MinWidth="600" MinHeight="500"
        d:Width="600" d:Height="500"
        ResizeMode="CanResizeWithGrip" SizeToContent="Width" >
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top menu: game actions, settings and help -->
        <Menu Grid.Row="0">
            <MenuItem Header="{x:Static l:Strings.GAMES}">
                <MenuItem Header="{x:Static l:Strings.ADD_GAME}" Command="{Binding AddGameCommand}" />
                <MenuItem Header="{x:Static l:Strings.CLEAR_LIST}" Command="{Binding ClearListCommand}" />
            </MenuItem>

            <MenuItem Header="{x:Static l:Strings.SETTINGS}">
                <MenuItem Header="{x:Static l:Strings.LANGUAGE}" ItemsSource="{Binding Languages}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsCurrent}" />
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                            <Setter Property="Command" Value="{Binding DataContext.ChangeLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding Key}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{x:Static l:Strings.HELP}">
                <MenuItem Header="{x:Static l:Strings.VIEW_HELP}" Command="{Binding HelpCommand}"/>
                <MenuItem Header="{x:Static l:Strings.CHECK_UPDATES}" IsEnabled="False"/>
                <MenuItem Header="{x:Static l:Strings.ABOUT}" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Primary action: pick and launch a random active game -->
        <Button Grid.Row="1" Content="{x:Static l:Strings.PLAY_GAME}"
                HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                    FontSize="32" FontWeight="Bold" Margin="10"
                    Command="{Binding PlayRandomGameCommand}"
                    ToolTip="{x:Static l:Strings.PLAY_GAME}"
                    Style="{DynamicResource PlayGameButton}" />

        <!-- Loading indicator shown while the catalog is being initialized -->
        <StackPanel Grid.Row="2" Margin="10,0,10,4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusText}" Margin="0,0,0,4" />
            <ProgressBar Height="4" IsIndeterminate="True" />
        </StackPanel>

        <!-- Main catalog grid -->
        <DataGrid Grid.Row="3" Margin="10" AutoGenerateColumns="False" ItemsSource="{Binding Games}"
                  CanUserAddRows="False" HorizontalAlignment="Center"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Standard"
                  d:ItemsSource="{d:SampleData ItemCount=30}" Cursor="Arrow" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="32" IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <CheckBox IsThreeState="True"
                                  IsChecked="{Binding IsAllActiveChecked, Mode=OneWay}"
                                  Command="{Binding ToggleAllActiveCommand}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Cursor="Hand"
                                      IsThreeState="False"
                                      IsChecked="{Binding Active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="32" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding AppIcon}" d:Source="./Resources/Icons/icon.ico" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Width="Auto" d:Width="120" Binding="{Binding Name}"
                                    IsReadOnly="True" Header="{x:Static l:Strings.NAME}" />

                <DataGridTextColumn Width="70" Binding="{Binding From}"
                                    IsReadOnly="True" Header="{x:Static l:Strings.FROM}" />

                <DataGridTextColumn Width="50" Binding="{Binding Type}"
                                    IsReadOnly="True" Header="{x:Static l:Strings.TYPE}" />

                <DataGridTextColumn Width="120" Binding="{Binding LaunchArguments}"
                                    IsReadOnly="True" Header="Args" />

                <DataGridTextColumn Width="Auto" d:Width="100" Binding="{Binding Folder}"
                                    IsReadOnly="True" Header="{x:Static l:Strings.FOLDER}" />


                <DataGridTemplateColumn Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Width="16" Height="16" Content="▶" Margin="0,0,10,0"
                                            Command="{Binding DataContext.RunGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{DynamicResource PlayGameButton}"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="10"
                                            Padding="0"
                                            ToolTip="{x:Static l:Strings.PLAY_GAME}" />

                                <Button Width="16" Height="16" Content="X"
                                            Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{DynamicResource RemoveButton}"
                                            FontFamily="Segoe UI"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Padding="0"
                                            ToolTip="{x:Static l:Strings.REMOVE_GAME_MSG}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar: store discovery diagnostics and current list status -->
        <StatusBar Grid.Row="4">
            <StatusBarItem Padding="5,0">
                <Image x:Name="SteamIcon" Width="32" Source="{Binding SteamIcon}" d:Source="./Resources/Icons/Steam.ico">
                    <Image.ToolTip>
                        <ToolTip Placement="Mouse" PlacementTarget="{Binding ElementName=SteamIcon}"
                                 IsOpen="{Binding IsMouseOver, ElementName=SteamIcon, Mode=OneWay}">
                            <TextBlock Text="{Binding Source={x:Static properties:Settings.Default}, Path=SteamPath}" />
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
            </StatusBarItem>
            <StatusBarItem Padding="5,0">
                <Image x:Name="EpicGamesIcon" Width="32" Source="{Binding EpicGamesIcon}" d:Source="./Resources/Icons/EpicGames.ico">
                    <Image.ToolTip>
                        <ToolTip Placement="Mouse" PlacementTarget="{Binding ElementName=EpicGamesIcon}"
                                 IsOpen="{Binding IsMouseOver, ElementName=EpicGamesIcon, Mode=OneWay}">
                            <TextBlock Text="{Binding Source={x:Static properties:Settings.Default}, Path=EpicGamesPath}" />
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
            </StatusBarItem>
            <StatusBarItem Padding="5,0" d:Content="30 games" HorizontalAlignment="Right" Content="{Binding StatusText}"/>
        </StatusBar>
    </Grid>
</Window>
