<Application x:Class="RandomGameLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomGameLauncher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <LinearGradientBrush x:Key="SteamWindowBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#101923" Offset="0" />
                        <GradientStop Color="#152334" Offset="0.5" />
                        <GradientStop Color="#0E171F" Offset="1" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="SteamBackground" Color="#101923" />
                    <SolidColorBrush x:Key="SteamBackgroundAlt" Color="#162434" />
                    <SolidColorBrush x:Key="SteamSurface" Color="#1B2838" />
                    <SolidColorBrush x:Key="SteamSurfaceElevated" Color="#223347" />
                    <SolidColorBrush x:Key="SteamForeground" Color="#D8E3F0" />
                    <SolidColorBrush x:Key="SteamForegroundMuted" Color="#8BA4B8" />
                    <SolidColorBrush x:Key="SteamAccent" Color="#66C0F4" />
                    <SolidColorBrush x:Key="SteamAccentStrong" Color="#1A9FFF" />
                    <SolidColorBrush x:Key="SteamAccentHover" Color="#8FD2FF" />
                    <SolidColorBrush x:Key="SteamDanger" Color="#C55353" />
                </ResourceDictionary>

                <ResourceDictionary Source="./Resources/Styles/Checkbox.xaml" />
                <ResourceDictionary Source="./Resources/Styles/DataGrid.xaml" />
                <ResourceDictionary Source="./Resources/Styles/Menu.xaml" />
                <ResourceDictionary Source="./Resources/Styles/PlayGameButton.xaml" />
                <ResourceDictionary Source="./Resources/Styles/RemoveButton.xaml" />
                <ResourceDictionary Source="./Resources/Styles/ScrollBar.xaml" />
                <ResourceDictionary Source="./Resources/Styles/StatusBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
